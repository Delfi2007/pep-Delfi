# Copy to backend/.env and paste a key. backend/.env is gitignored.
#
# Set EITHER of these. With both set, Groq wins by default (it's the one
# with a free tier); pin the choice with ACPIA_LLM_PROVIDER if you care.
#
# Groq — free tier, OpenAI-compatible, open-weights models.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic — needs a funded Console account (a Claude Pro/Max
# subscription does NOT include API credits).
ANTHROPIC_API_KEY=

# Optional overrides.
#   ACPIA_LLM_PROVIDER : auto (default) | groq | anthropic
#   ACPIA_GROQ_MODEL   : default openai/gpt-oss-120b
#                        (llama-3.3-70b-versatile is the fallback;
#                         NOT groq/compound — it can't call our tools)
#   ACPIA_GROQ_REASONING_EFFORT : low | medium | high (default medium;
#                        only sent to gpt-oss models, which accept it).
#                        Do not raise this to high on a small token
#                        budget: reasoning tokens come out of the same
#                        completion budget as the answer, so the model
#                        can spend the whole budget thinking and return
#                        an EMPTY message with finish_reason="length".
#   ACPIA_ANTHROPIC_MODEL : default claude-opus-5
ACPIA_LLM_PROVIDER=auto

# With neither key set, triage still works — it falls back to the
# deterministic rule-based path (ACPIA_Plan.md section 7, rung 1), which
# is cited the same way and is a coherent demo on its own.
